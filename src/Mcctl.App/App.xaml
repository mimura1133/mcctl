<Application x:Class="Mcctl.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Mcctl.App.Converters"
             ThemeMode="System"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
            <conv:NullToVisibilityConverter x:Key="EmptyToCollapsed" />
            <conv:EqualsConverter x:Key="Equals" />

            <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="FontFamily" Value="{StaticResource Icons}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Margin" Value="3" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <Style x:Key="BigIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="Width" Value="60" />
                <Setter Property="Height" Value="52" />
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Opacity" Value="0.75" />
                <Setter Property="Margin" Value="0,12,0,6" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="Opacity" Value="0.8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
