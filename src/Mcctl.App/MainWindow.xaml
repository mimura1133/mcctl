<Window x:Class="Mcctl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Mcctl.App.ViewModels"
        xmlns:ctl="clr-namespace:Mcctl.App.Controls"
        xmlns:l="clr-namespace:Mcctl.App.Localization"
        Title="mcctl (unofficial controller for MusicCast, Windows)" Width="1180" Height="780" MinWidth="300" MinHeight="260"
        WindowStartupLocation="CenterScreen"
        Topmost="{Binding IsPinned}"
        SizeChanged="OnSizeChanged">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Speaker icon that lights up in the accent colour when the device is on -->
        <Style x:Key="PowerIndicator" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Text" Value="&#xE7F5;" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.35" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOn}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ContextMenu x:Key="DeviceContextMenu">
            <MenuItem Header="{l:Tr RemoveFromList}"
                      Command="{Binding PlacementTarget.Tag.RemoveDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
        </ContextMenu>

        <!--
            Power button: accent while the device is on.
            The Fluent Button template paints its own colour on hover/press and ignores Background, which made the
            accent disappear on mouse-over. This template draws Background itself, so the triggers below control
            every state (normal / hover / pressed × on / standby).
        -->
        <Style x:Key="PowerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- standby -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                </Trigger>

                <!-- on (declared later, so it wins over the standby hover/press colours) -->
                <DataTrigger Binding="{Binding IsOn}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsOn}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsOn}" Value="True" />
                        <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                </MultiDataTrigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ======================================================= -->
        <!-- Full layout                                             -->
        <!-- ======================================================= -->
        <Grid Visibility="{Binding IsCompact, Converter={StaticResource InvBoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= Room pane (collapsible) ================= -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="290" />
                        <Setter Property="Padding" Value="12" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRoomPaneOpen}" Value="False">
                                <Setter Property="Width" Value="60" />
                                <Setter Property="Padding" Value="6,12" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE700;" Margin="0,0,6,0"
                                ToolTip="{l:Tr ToggleRoomPane}" Command="{Binding ToggleRoomPaneCommand}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;"
                                ToolTip="{l:Tr SearchDevices}" Command="{Binding SearchCommand}"
                                Visibility="{Binding IsRoomPaneOpen, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{l:Tr Rooms}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Visibility="{Binding IsRoomPaneOpen, Converter={StaticResource BoolToVis}}" />
                    </DockPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"
                                Visibility="{Binding IsRoomPaneOpen, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{l:Tr AddByIp}" Style="{StaticResource SectionHeader}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:Tr Add}" Margin="6,0,0,0" Command="{Binding AddHostCommand}" />
                            <TextBox Text="{Binding ManualHost, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Tr IpExample}" />
                        </DockPanel>
                        <TextBlock Text="{l:Tr Language}" Style="{StaticResource SectionHeader}" />
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                  DisplayMemberPath="Name" ToolTip="Language / 表示言語" />
                    </StackPanel>

                    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,6"
                                 Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" />

                    <Grid>
                        <!-- Expanded: name, model, input -->
                        <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Visibility="{Binding IsRoomPaneOpen, Converter={StaticResource BoolToVis}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DeviceViewModel}">
                                    <Grid Margin="2,6" Background="Transparent" ContextMenu="{StaticResource DeviceContextMenu}"
                                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource PowerIndicator}" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Model, Mode=OneWay}" /> · <Run Text="{Binding Host, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding SelectedInput.Name}"
                                                       Visibility="{Binding IsOn, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Collapsed: icon strip, name in the tooltip -->
                        <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Visibility="{Binding IsRoomPaneOpen, Converter={StaticResource InvBoolToVis}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DeviceViewModel}">
                                    <Grid Margin="0,6" Background="Transparent" ContextMenu="{StaticResource DeviceContextMenu}"
                                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                        <Grid.ToolTip>
                                            <TextBlock>
                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><LineBreak />
                                                <Run Text="{Binding SelectedInput.Name, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid.ToolTip>
                                        <TextBlock Style="{StaticResource PowerIndicator}" HorizontalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ================= Selected device ================= -->
            <TextBlock Grid.Column="1" Text="{l:Tr SelectDevice}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.6" FontSize="16"
                       Visibility="{Binding HasSelection, Converter={StaticResource InvBoolToVis}}" />

            <Grid Grid.Column="1" Margin="18,12,18,8" DataContext="{Binding SelectedDevice}"
                  Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <DockPanel Grid.Row="0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding Zones}" SelectedItem="{Binding SelectedZone}" MinWidth="140" Margin="0,0,8,0"
                                  ToolTip="{l:Tr Zone}" />
                        <!-- Icon only; accent while the device is on -->
                        <Button Command="{Binding PowerCommand}" Width="44" Height="36" Padding="0"
                                FontFamily="{StaticResource Icons}" FontSize="16" Content="&#xE7E8;"
                                ToolTip="{Binding PowerActionToolTip}" Style="{StaticResource PowerButton}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Opacity="0.7">
                            <Run Text="{Binding Model, Mode=OneWay}" /> · <Run Text="{Binding Host, Mode=OneWay}" />
                            <Run Foreground="OrangeRed">
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Setter Property="Text" Value="{l:Tr Offline}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                <Setter Property="Text" Value="" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <!-- Main controls -->
                <Border Grid.Row="1" Margin="0,12,0,8" Padding="12" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        IsEnabled="{Binding IsOn}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                            <Button Command="{Binding MuteCommand}" ToolTip="{l:Tr Mute}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <Setter Property="Content" Value="&#xE767;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Mute}" Value="True">
                                                <Setter Property="Content" Value="&#xE74F;" />
                                                <Setter Property="Foreground" Value="OrangeRed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Content="&#xE738;" Command="{Binding VolumeDownCommand}" ToolTip="{l:Tr VolumeDown}" />
                        </StackPanel>
                        <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="{Binding MaxVolume}" Value="{Binding Volume}"
                                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="6,0" />
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Content="&#xE710;" Command="{Binding VolumeUpCommand}" ToolTip="{l:Tr VolumeUp}" />
                            <TextBlock Text="{Binding VolumeText}" MinWidth="64" FontSize="18" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextAlignment="Right" />
                        </StackPanel>

                        <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                                <TextBlock Text="{l:Tr Input}" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Inputs}" SelectedItem="{Binding SelectedInput}" MinWidth="200" ToolTip="{l:Tr Input}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,4"
                                        Visibility="{Binding HasSoundPrograms, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{l:Tr SoundProgram}" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding SoundPrograms}" SelectedItem="{Binding SelectedSoundProgram}" MinWidth="180" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                                <TextBlock Text="{l:Tr Sleep}" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding SleepOptions}" SelectedItem="{Binding SelectedSleep}" MinWidth="100" />
                            </StackPanel>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Tabs -->
                <TabControl Grid.Row="2" IsEnabled="{Binding IsOn}">

                    <!-- Now playing -->
                    <TabItem Header="{l:Tr NowPlaying}">
                        <Grid Margin="8,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="260" Height="260" CornerRadius="8" VerticalAlignment="Top" ClipToBounds="True"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                <Grid>
                                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8D6;" FontSize="72" Opacity="0.3"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding AlbumArt, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                                    <Image Source="{Binding AlbumArt}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                <TextBlock Text="{Binding SelectedInput.Name}" Opacity="0.6" />
                                <TextBlock Text="{Binding Track}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Artist}" FontSize="16" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Album}" FontSize="14" Opacity="0.7" TextWrapping="Wrap" />

                                <!-- audio format badge (e.g. "MP3 · 44.1 kHz") -->
                                <Border HorizontalAlignment="Left" Margin="0,10,0,0" Padding="8,2" CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        Visibility="{Binding AudioFormatText, Converter={StaticResource EmptyToCollapsed}}">
                                    <TextBlock Text="{Binding AudioFormatText}" FontSize="12" Opacity="0.85" />
                                </Border>

                                <!-- position: progress when the length is known, elapsed time otherwise -->
                                <Grid Margin="0,16,0,0" Visibility="{Binding HasDuration, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PlayTimeText}" VerticalAlignment="Center" MinWidth="48" />
                                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="{Binding TotalTime}" Value="{Binding PlayTime, Mode=OneWay}"
                                                 Height="4" Margin="8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding TotalTimeText}" VerticalAlignment="Center" MinWidth="48" TextAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{Binding PlayTimeText}" Margin="0,16,0,0" Opacity="0.8">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ShowsPlayTime}" Value="True" />
                                                        <Condition Binding="{Binding HasDuration}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- transport -->
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                            Visibility="{Binding HasTransport, Converter={StaticResource BoolToVis}}">
                                    <Button Command="{Binding ShuffleCommand}" ToolTip="{l:Tr Shuffle}" Content="&#xE8B1;">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Shuffle}" Value="off">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Style="{StaticResource BigIconButton}" Content="&#xE892;" Command="{Binding PreviousCommand}" ToolTip="{l:Tr Previous}" />
                                    <Button Style="{StaticResource BigIconButton}" Content="{Binding PlayPauseGlyph}" Command="{Binding PlayPauseCommand}" ToolTip="{l:Tr PlayPause}" />
                                    <Button Style="{StaticResource BigIconButton}" Content="&#xE893;" Command="{Binding NextCommand}" ToolTip="{l:Tr Next}" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE71A;" Command="{Binding StopCommand}" ToolTip="{l:Tr Stop}" />
                                    <Button Command="{Binding RepeatCommand}" ToolTip="{l:Tr Repeat}" Content="{Binding RepeatGlyph}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Repeat}" Value="off">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE7E7;" Command="{Binding CdTrayCommand}" ToolTip="{l:Tr Tray}"
                                            Visibility="{Binding IsCd, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <!-- tuner -->
                                <StackPanel Margin="0,16,0,0" Visibility="{Binding IsTuner, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding TunerBands}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding}" MinWidth="60" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.SetBandCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE892;" Command="{Binding SeekDownCommand}" ToolTip="{l:Tr SeekDown}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Command="{Binding TuneDownCommand}" ToolTip="{l:Tr FreqDown}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Command="{Binding TuneUpCommand}" ToolTip="{l:Tr FreqUp}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" Command="{Binding SeekUpCommand}" ToolTip="{l:Tr SeekUp}" />
                                        <Separator Width="16" Background="Transparent" />
                                        <Button Content="{l:Tr PresetPrevButton}" Command="{Binding TunerPresetPrevCommand}" Margin="3" />
                                        <Button Content="{l:Tr PresetNextButton}" Command="{Binding TunerPresetNextCommand}" Margin="3" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{l:Tr DirectTune}" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding DirectFrequency, UpdateSourceTrigger=PropertyChanged}" Width="110"
                                                 ToolTip="{l:Tr DirectTuneHint}" />
                                        <Button Content="{l:Tr Tune}" Command="{Binding DirectTuneCommand}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- Browse -->
                    <TabItem Header="{l:Tr Browse}">
                        <Grid Margin="4,8">
                            <TextBlock Text="{l:Tr BrowseUnavailable}" Opacity="0.6"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Visibility="{Binding IsNetUsb, Converter={StaticResource InvBoolToVis}}" />
                            <DockPanel Visibility="{Binding IsNetUsb, Converter={StaticResource BoolToVis}}">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE72B;" Command="{Binding BrowseBackCommand}" ToolTip="{l:Tr Back}" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding BrowseRefreshCommand}" ToolTip="{l:Tr Reload}" />
                                    <TextBlock Text="{Binding MenuName}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3"
                                             Visibility="{Binding BrowseBusy, Converter={StaticResource BoolToVis}}" />
                                <!-- search box: shown after opening a search entry such as Net Radio → Radio → 検索する -->
                                <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="10" CornerRadius="6" BorderThickness="1"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        Visibility="{Binding IsSearchPromptVisible, Converter={StaticResource BoolToVis}}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" Opacity="0.8">
                                            <Run Text="{Binding PendingSearch.Text, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{l:Tr SearchPrompt}" />
                                        </TextBlock>
                                        <Button DockPanel.Dock="Right" Content="{l:Tr Cancel}" Margin="6,0,0,0" Command="{Binding CancelSearchCommand}" />
                                        <Button DockPanel.Dock="Right" Content="{l:Tr Search}" Margin="6,0,0,0" Command="{Binding RunSearchCommand}" />
                                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsVisibleChanged="OnSearchBoxVisibleChanged" ToolTip="{l:Tr SearchExample}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding RunSearchCommand}" />
                                                <KeyBinding Key="Escape" Command="{Binding CancelSearchCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </DockPanel>
                                </Border>
                                <ListView ItemsSource="{Binding BrowseItems}" x:Name="BrowseList"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          VirtualizingPanel.IsVirtualizing="True">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:BrowseItem}">
                                            <Grid Background="Transparent" Margin="0,2">
                                                <Grid.InputBindings>
                                                    <MouseBinding Gesture="LeftDoubleClick"
                                                                  Command="{Binding DataContext.BrowseOpenCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                  CommandParameter="{Binding}" />
                                                </Grid.InputBindings>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontFamily="{StaticResource Icons}" Text="{Binding Glyph}" FontSize="16"
                                                           VerticalAlignment="Center" Margin="4,0,12,0" Opacity="0.75" />
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="{l:Tr Play}"
                                                            Visibility="{Binding IsPlayable, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.BrowsePlayCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE76C;" ToolTip="{l:Tr Open}"
                                                            Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.BrowseOpenCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding}" />
                                                            <Button Style="{StaticResource IconButton}" Content="&#xE721;" ToolTip="{l:Tr Search}"
                                                                    Visibility="{Binding IsSearchable, Converter={StaticResource BoolToVis}}"
                                                                    Command="{Binding DataContext.BrowseOpenCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                    CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </DockPanel>
                        </Grid>
                    </TabItem>

                    <!-- Presets / recent -->
                    <TabItem Header="{l:Tr Presets}">
                        <Grid Margin="4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{l:Tr NetFavorites}" Style="{StaticResource SectionHeader}" />
                            <ListBox Grid.Row="1" ItemsSource="{Binding NetPresets}" x:Name="NetPresetList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PresetItem}">
                                        <Grid Background="Transparent">
                                            <Grid.InputBindings>
                                                <MouseBinding Gesture="LeftDoubleClick"
                                                              Command="{Binding DataContext.RecallPresetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                              CommandParameter="{Binding}" />
                                            </Grid.InputBindings>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Number}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Opacity="0.6" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.65" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Grid.Column="2" Style="{StaticResource SectionHeader}" Text="{l:Tr RecentAndTunerPresets}" />
                            <TabControl Grid.Column="2" Grid.Row="1">
                                <TabItem Header="{l:Tr Recent}">
                                    <ListBox ItemsSource="{Binding RecentItems}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:RecentItemVm}">
                                                <Grid Background="Transparent">
                                                    <Grid.InputBindings>
                                                        <MouseBinding Gesture="LeftDoubleClick"
                                                                      Command="{Binding DataContext.RecallRecentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                      CommandParameter="{Binding}" />
                                                    </Grid.InputBindings>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Input}" FontSize="11" Opacity="0.65" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </TabItem>
                                <TabItem Header="{l:Tr Tuner}" Visibility="{Binding HasTuner, Converter={StaticResource BoolToVis}}">
                                    <ListBox ItemsSource="{Binding TunerPresets}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:PresetItem}">
                                                <Grid Background="Transparent">
                                                    <Grid.InputBindings>
                                                        <MouseBinding Gesture="LeftDoubleClick"
                                                                      Command="{Binding DataContext.RecallPresetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                      CommandParameter="{Binding}" />
                                                    </Grid.InputBindings>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Number}" FontSize="16" FontWeight="SemiBold" Opacity="0.6" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </TabItem>
                            </TabControl>

                            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{l:Tr StorePresetPrefix}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding StorePresetNumber, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                <Button Content="{l:Tr StorePresetSuffix}" Command="{Binding StorePresetCommand}" Margin="6,0,0,0" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshPresetsCommand}" ToolTip="{l:Tr Reload}" Margin="12,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- Sound -->
                    <TabItem Header="{l:Tr SoundProgram}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8" MaxWidth="560" HorizontalAlignment="Left">
                                <StackPanel Visibility="{Binding SupportsTone, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{l:Tr ToneControl}" Style="{StaticResource SectionHeader}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{l:Tr Bass}" Style="{StaticResource FieldLabel}" />
                                        <Slider Grid.Column="1" Minimum="{Binding ToneMin}" Maximum="{Binding ToneMax}" Value="{Binding Bass}"
                                                IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,6" />
                                        <TextBlock Grid.Column="2" Text="{Binding Bass}" VerticalAlignment="Center" TextAlignment="Right" />
                                        <TextBlock Grid.Row="1" Text="{l:Tr Treble}" Style="{StaticResource FieldLabel}" />
                                        <Slider Grid.Row="1" Grid.Column="1" Minimum="{Binding ToneMin}" Maximum="{Binding ToneMax}" Value="{Binding Treble}"
                                                IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,6" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Treble}" VerticalAlignment="Center" TextAlignment="Right" />
                                    </Grid>
                                </StackPanel>

                                <TextBlock Text="{l:Tr SoundFeatures}" Style="{StaticResource SectionHeader}" />
                                <ItemsControl ItemsSource="{Binding FeatureToggles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:FeatureToggle}">
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding State}" Margin="0,4"
                                                      Command="{Binding DataContext.ToggleFeatureCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{l:Tr NoSoundFeatures}" Opacity="0.6"
                                           Visibility="{Binding FeatureToggles.Count, Converter={StaticResource Equals}, ConverterParameter=0}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Link -->
                    <TabItem Header="{l:Tr Link}">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:Tr LinkStatus}" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="{Binding LinkRoleText}" FontSize="16" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="{l:Tr GroupName}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}" Width="220" />
                                </StackPanel>
                                <TextBlock Text="{l:Tr LinkedDevices}" Style="{StaticResource SectionHeader}" />
                                <ItemsControl ItemsSource="{Binding LinkedClients}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,2">
                                                <Run FontFamily="{StaticResource Icons}" Text="&#xE7F5;" /> <Run Text="{Binding Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="{l:Tr Unlink}" Command="{Binding UnlinkCommand}" Margin="0,16,0,0" HorizontalAlignment="Left" MinWidth="140" />
                            </StackPanel>

                            <DockPanel Grid.Column="2">
                                <TextBlock DockPanel.Dock="Top" Text="{l:Tr LinkTargets}" Style="{StaticResource SectionHeader}" />
                                <Button DockPanel.Dock="Bottom" Content="{l:Tr LinkSelected}" Command="{Binding LinkCommand}"
                                        Margin="0,10,0,0" HorizontalAlignment="Left" MinWidth="180" />
                                <ListBox ItemsSource="{Binding LinkCandidates}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:LinkCandidate}">
                                            <CheckBox IsChecked="{Binding IsChecked}" Margin="0,2">
                                                <TextBlock>
                                                    <Run Text="{Binding Device.Name, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text="{Binding Device.Model, Mode=OneWay}" Foreground="Gray" />
                                                </TextBlock>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Grid>
                    </TabItem>

                    <!-- Info -->
                    <TabItem Header="{l:Tr Info}">
                        <StackPanel Margin="8">
                            <TextBlock Text="{l:Tr DeviceInfo}" Style="{StaticResource SectionHeader}" />
                            <TextBox Text="{Binding InfoText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"
                                     BorderThickness="0" Background="Transparent" />
                            <Button Content="{l:Tr ReloadAll}" Command="{Binding RefreshCommand}" Margin="0,12,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- ======================================================= -->
        <!-- Mini player (shown when the window is small)            -->
        <!-- ======================================================= -->
        <Grid Margin="12" Visibility="{Binding IsCompact, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Room picker, power, pin -->
            <DockPanel Grid.Row="0">
                <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsPinned}" Width="36" Height="32" Margin="4,0,0,0"
                              FontFamily="{StaticResource Icons}" Content="&#xE718;" ToolTip="{l:Tr AlwaysOnTop}" />
                <Button DockPanel.Dock="Right" DataContext="{Binding SelectedDevice}" Command="{Binding PowerCommand}"
                        Style="{StaticResource PowerButton}" Width="36" Height="32" Margin="4,0,0,0" Padding="0"
                        FontFamily="{StaticResource Icons}" Content="&#xE7E8;" ToolTip="{Binding PowerActionToolTip}"
                        IsEnabled="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}}" />
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name"
                          ToolTip="{l:Tr Rooms}" />
            </DockPanel>

            <TextBlock Grid.Row="1" Grid.RowSpan="4" Text="{l:Tr NoDevices}" Opacity="0.6"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HasSelection, Converter={StaticResource InvBoolToVis}}" />

            <!-- Now playing: artwork above the text, scaled and centred together as one block -->
            <ctl:ArtworkStackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="10" MaxArtSize="360" ClipToBounds="True"
                                   DataContext="{Binding SelectedDevice}" IsEnabled="{Binding IsOn}"
                                   Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <Border CornerRadius="8" ClipToBounds="True" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid>
                        <Viewbox Margin="24" Visibility="{Binding AlbumArt, Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8D6;" Opacity="0.3" />
                        </Viewbox>
                        <Image Source="{Binding AlbumArt}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>
                <StackPanel>
                    <TextBlock Text="{Binding SelectedInput.Name}" FontSize="11" Opacity="0.6" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Track}" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Artist}" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Album}" FontSize="12" Opacity="0.7" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <!-- elapsed / total: bar when the length is known, otherwise just the centred elapsed time -->
                    <Grid Margin="0,6,0,0" Visibility="{Binding ShowsPlayTime, Converter={StaticResource BoolToVis}}">
                        <DockPanel Visibility="{Binding HasDuration, Converter={StaticResource BoolToVis}}">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding PlayTimeText}" FontSize="11" Opacity="0.8"
                                       VerticalAlignment="Center" MinWidth="32" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TotalTimeText}" FontSize="11" Opacity="0.8"
                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                            <ProgressBar Minimum="0" Maximum="{Binding TotalTime}" Value="{Binding PlayTime, Mode=OneWay}" Height="3"
                                         Margin="6,0,0,0" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding PlayTimeText}" FontSize="11" Opacity="0.8" HorizontalAlignment="Center"
                                   Visibility="{Binding HasDuration, Converter={StaticResource InvBoolToVis}}" />
                    </Grid>
                </StackPanel>
            </ctl:ArtworkStackPanel>

            <!-- Transport (network / CD) or tuner presets -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0"
                        DataContext="{Binding SelectedDevice}" IsEnabled="{Binding IsOn}">
                <StackPanel Orientation="Horizontal" Visibility="{Binding HasTransport, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource IconButton}" Content="&#xE892;" Command="{Binding PreviousCommand}" ToolTip="{l:Tr Previous}" />
                    <Button Style="{StaticResource IconButton}" Width="52" FontSize="20" Content="{Binding PlayPauseGlyph}"
                            Command="{Binding PlayPauseCommand}" ToolTip="{l:Tr PlayPause}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE893;" Command="{Binding NextCommand}" ToolTip="{l:Tr Next}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsTuner, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource IconButton}" Content="&#xE892;" Command="{Binding TunerPresetPrevCommand}" ToolTip="{l:Tr PresetPrev}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE893;" Command="{Binding TunerPresetNextCommand}" ToolTip="{l:Tr PresetNext}" />
                </StackPanel>
            </StackPanel>

            <!-- Volume -->
            <Grid Grid.Row="3" Margin="0,6,0,0" DataContext="{Binding SelectedDevice}" IsEnabled="{Binding IsOn}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Command="{Binding MuteCommand}" ToolTip="{l:Tr Mute}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Content" Value="&#xE767;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Mute}" Value="True">
                                    <Setter Property="Content" Value="&#xE74F;" />
                                    <Setter Property="Foreground" Value="OrangeRed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Slider Grid.Column="1" Minimum="0" Maximum="{Binding MaxVolume}" Value="{Binding Volume}"
                        IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="4,0" />
                <TextBlock Grid.Column="2" Text="{Binding VolumeText}" MinWidth="36" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextAlignment="Right" />
            </Grid>

            <!-- Input -->
            <ComboBox Grid.Row="4" Margin="0,6,0,0" DataContext="{Binding SelectedDevice}" IsEnabled="{Binding IsOn}"
                      ItemsSource="{Binding Inputs}" SelectedItem="{Binding SelectedInput}" ToolTip="{l:Tr Input}" />
        </Grid>

        <!-- ======================================================= -->
        <!-- Notification toast (replaces the status bar)            -->
        <!-- ======================================================= -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" MaxWidth="460" Padding="14,10"
                CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Visibility="{Binding IsNotificationVisible, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" />
            </Border.Effect>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11"
                        Margin="10,0,0,0" VerticalAlignment="Top" Content="&#xE711;" ToolTip="{l:Tr Close}"
                        Command="{Binding DismissNotificationCommand}" />
                <TextBlock Text="{Binding Notification}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
