<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>mcctl-gui</AssemblyName>
    <RootNamespace>Mcctl.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Fluent ThemeMode is still flagged experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mcctl.Core\Mcctl.Core.csproj" />
  </ItemGroup>

</Project>
